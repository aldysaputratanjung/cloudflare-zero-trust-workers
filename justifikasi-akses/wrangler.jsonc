{
  "name": "justifikasi-akses",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [{ "binding": "SESSIONS", "id": "<KV_NAMESPACE_ID>" }],
  "d1_databases": [{ "binding": "AUDIT", "database_id": "<D1_DATABASE_ID>" }],
  "observability": { "enabled": true },
  "vars": {
    "SESSION_TTL_SECONDS": "86400",
    "REASON_MAX_LENGTH": "500"
  }
}
